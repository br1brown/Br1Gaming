{
  "standard": "WCAG2AA",
  "level": "error",
  "runners": [
    "axe",
    "htmlcs"
  ],
  "axeRules": [
    "target-size"
  ],
  "levelCapWhenNeedsReview": "warning",
  "includeWarnings": true,
  "hideElements": ".swal2-container",
  "wait": 400,
  "chromeLaunchConfig": {
    "args": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu"
    ]
  }
}
