+/**
+ * WORKAROUND WebKit iOS: un elemento `position: fixed` aggiunto al DOM (o reso visibile) DOPO il
+ * primo paint — come il banner cookie o una modale SweetAlert2 create al volo — su Safari/WebKit
+ * iOS a volte resta "sganciato" dal viewport finché non arriva un reflow: si vede nel punto in cui
+ * è stato inserito nel flusso del documento invece che ancorato allo schermo. Chrome/Firefox non
+ * sono affetti (verificato). Il fix è una lettura di layout forzata dopo due frame di animazione
+ * (dà tempo al browser di dipingere il nodo prima di ricalcolare), che fa ricalcolare a WebKit il
+ * layer di compositing — nessun effetto visivo, nessuna scrittura sul DOM.
+ */
+export function forceWebkitFixedReflow(): void {
+    if (typeof window === 'undefined') return;
+    requestAnimationFrame(() => requestAnimationFrame(() => {
+        void document.body.offsetHeight;
+    }));
+}
